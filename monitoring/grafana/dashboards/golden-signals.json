{
  "title": "StudentSystemGo — Golden Signals",
  "uid": "ssg-golden",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s","10s","30s","1m","5m"] },
  "tags": ["studentsystemgo","golden-signals"],
  "panels": [
    {
      "id": 1,
      "title": "Traffic — Request rate (req/s) by path",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (path) (rate(studentsystemgo_http_requests_total[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency — P50 / P95 / P99 across all paths",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(studentsystemgo_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(studentsystemgo_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(studentsystemgo_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors — 5xx rate (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "(sum(rate(studentsystemgo_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / (sum(rate(studentsystemgo_http_requests_total[5m])) > 0) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Errors — 4xx rate (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "(sum(rate(studentsystemgo_http_requests_total{status=~\"4..\"}[5m])) or vector(0)) / (sum(rate(studentsystemgo_http_requests_total[5m])) > 0) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Saturation — RabbitMQ queue depth",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready",
          "legendFormat": "{{queue}} (ready)",
          "refId": "A"
        },
        {
          "expr": "rabbitmq_queue_messages_unacked",
          "legendFormat": "{{queue}} (unacked)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Worker — messages processed (rate/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (queue) (rate(studentsystemgo_worker_messages_processed_total[1m]))",
          "legendFormat": "{{queue}} processed",
          "refId": "A"
        },
        {
          "expr": "sum by (queue) (rate(studentsystemgo_worker_messages_failed_total[1m]))",
          "legendFormat": "{{queue}} failed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Saturation — DB connections (primary vs replica)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "{{job}} threads connected",
          "refId": "A"
        }
      ]
    }
  ]
}
